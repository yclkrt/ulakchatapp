rules_version = '2';

// ÖRNEK - gerçek projen için düzenle.
// Firebase Console > Firestore Database > Rules bölümüne yapıştır.
// Asla `allow read, write: if true;` bırakma!

service cloud.firestore {
  match /databases/{database}/documents {

    // Herkes okuyabilir/yazabilir = GÜVENSİZ (sadece deneme için):
    // match /{document=**} {
    //   allow read, write: if true;
    // }

    // Güvenli başlangıç: giriş yapan kullanıcı kendi verisine erişir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Sohbet örneği: üye olan okur/yazar
    // match /chats/{chatId} {
    //   allow read: if request.auth != null
    //     && request.auth.uid in resource.data.members;
    //   allow create: if request.auth != null
    //     && request.auth.uid in request.resource.data.members;
    //   allow update: if request.auth != null
    //     && request.auth.uid in resource.data.members;
    //   allow delete: if false;
    //
    //   match /messages/{messageId} {
    //     allow read: if request.auth != null
    //       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    //     allow create: if request.auth != null
    //       && request.resource.data.senderId == request.auth.uid;
    //     allow update, delete: if false;
    //   }
    // }

    // Varsayılan: her şeyi kapat
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
